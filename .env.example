# Environment variables for distribuidora-aluminio-site
#
# Copy this file to `.env.local` for local development
# (or configure the same variable in your deployment platform's
# environment variable settings, e.g. Vercel Project Settings > Environment Variables).
#
# Never commit a real `.env` / `.env.local` file or a real key value to git.
# `.env` is already excluded via .gitignore.

# API key for currencyapi.com, used server-side only by the
# USD -> BRL quote proxy at app/api/quotes/usdbrl/route.ts.
# Without this variable set, that route returns HTTP 500 and the
# homepage currency widget (components/site/InfoCards.tsx) shows an error state.
# Get a key at: https://currencyapi.com
CURRENCYAPI_KEY=
